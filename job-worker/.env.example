# Copy to .env for docker-compose. App reads the same DB via EC2_JOBS_DATABASE_URL.
POSTGRES_USER=jobs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jobs
DB_PORT=5432
EMBED_PORT=8080
SCRAPE_INTERVAL_HOURS=6
# Bearer for the shim's /match + /status (app reads jobs via these). openssl rand -hex 32
# Must match EC2_JOBS_TOKEN in the Worker's secrets.
JOBS_SHIM_TOKEN=change-me
