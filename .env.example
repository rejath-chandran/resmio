# Database URL for SQLite
DATABASE_URL="dev.db"

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET= # npx -y @better-auth/cli secret

# Social login (optional). Each button only works when its pair is set.
# Google: console.cloud.google.com → OAuth client. Redirect URI:
#   ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: github.com/settings/developers → OAuth App. Callback URL:
#   ${BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated emails auto-promoted to admin on login. Bootstraps the first
# admin per environment; admins promote others from /admin/users afterwards.
ADMIN_EMAILS=

# OpenAI-compatible AI (any provider: OpenAI, Groq, OpenRouter, local vLLM...)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Cashfree payments (Indian PG). Get keys from the Cashfree merchant dashboard.
# Leave blank to run without billing — the app degrades to "not configured".
# Webhook: point Cashfree to ${BETTER_AUTH_URL}/api/cashfree/webhook
CASHFREE_ENV=sandbox           # sandbox | production
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# AI Job Match (Pro) — the job-worker on EC2. Leave blank to disable the feature
# (it degrades to "not configured"). Restrict both ports to this app's IP in the
# EC2 security group; the embed shim is unauthenticated.
EC2_JOBS_DATABASE_URL=          # postgresql://jobs:<pw>@<ec2-ip>:5432/jobs
EC2_EMBED_URL=                  # http://<ec2-ip>:8080

# Portfolio hosting (Pro) — the site-host publisher shim on EC2. Leave blank to
# disable (degrades to "not configured"). Token must match ~/site-host/.env on the
# box; restrict :8090 to this app's IP in the EC2 security group.
SITE_PUBLISH_URL=               # http://<ec2-ip>:8090
SITE_PUBLISH_TOKEN=             # same as SITE_PUBLISH_TOKEN in site-host/.env
SITE_BASE_DOMAIN=resmio.in
