# Database URL for SQLite
DATABASE_URL="dev.db"

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET= # npx -y @better-auth/cli secret

# Comma-separated emails auto-promoted to admin on login. Bootstraps the first
# admin per environment; admins promote others from /admin/users afterwards.
ADMIN_EMAILS=

# OpenAI-compatible AI (any provider: OpenAI, Groq, OpenRouter, local vLLM...)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
